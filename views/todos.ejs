
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>My Todo List</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <h1>My Todo List</h1>

        <form action="/todos" method="POST">
            <input type="text" name="title"
                   placeholder="할 일을 입력하세요" required>
            <input type="date" name="due_date">
            <button type="submit">추가</button>
        </form>

        <div class="filters">
            <a href="/todos?filter=all">전체</a>
            <a href="/todos?filter=active">미완료</a>
            <a href="/todos?filter=completed">완료</a>
        </div>

        <ul>
            <% todos.forEach(todo => { %>
                <li>
                    <span class="<%= todo.completed ? 'done' : '' %>">
                        <%= todo.title %>
                    </span>

                    <small>
                        마감일: <%= todo.due_date || '미설정' %>
                    </small>

                    <form action="/todos/<%= todo.id %>/toggle"
                          method="POST">
                        <button type="submit">
                            <%= todo.completed ? '완료 취소' : '완료' %>
                        </button>
                    </form>

                    <a href="/todos/<%= todo.id %>/edit">수정</a>

                    <form action="/todos/<%= todo.id %>/delete"
                          method="POST">
                        <button type="submit">삭제</button>
                    </form>
                </li>
            <% }) %>
        </ul>
    </div>
</body>
</html>
